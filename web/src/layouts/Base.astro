---
// Every page of the site: the head, the aurora behind the page and the footer.
// Open Sans is served with the site (the file for each alphabet loads only
// when a page has text in it), so pages load nothing from elsewhere.
import "@fontsource/open-sans/300.css";
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/600.css";
import "../styles/site.css";
import Aurora from "../components/Aurora.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/site.js";

const { title = "Menuseum", description = "An archive of interactive DVD menus." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
<slot name="head" />
</head>
<body>
<Aurora />
<slot />
<Footer />
</body>
</html>
