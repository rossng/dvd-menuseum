---
import Base from "../layouts/Base.astro";
import { discMarkup } from "../lib/disc.js";
import { discs, url, playUrl } from "../lib/site.js";

const mb = (bytes) => (bytes >= 1e6 ? `${Math.round(bytes / 1e6)} MB` : `${Math.round(bytes / 1e3)} KB`);
const by = (d) => [d.maker, d.year].filter(Boolean).join(", ");
const facts = (d) => [`${mb(d.bytes)} of menus`, `${d.title_sets} title set${d.title_sets === 1 ? "" : "s"}`].join(" · ");
---
<Base>
<style is:global>
  header { text-align: center; padding: clamp(32px, 7vh, 72px) 16px 0; }
  header .wordmark { font-size: clamp(2.6rem, 8vw, 4.4rem); }
  header p { margin: 10px 0 0; font-size: clamp(1rem, 2.4vw, 1.2rem); font-weight: 300; color: var(--text-dim); }
  main { padding: 0 16px; }

  /* The shelf: discs on a ring, seen from slightly above, standing on a
     glossy floor at --floor that reflects them. --i is each disc's place
     on the ring; the ring turns to bring --at to the front. */
  .shelf {
    --size: min(280px, 58vw);
    --centre: calc(var(--size) * 0.72);
    --floor: calc(var(--centre) + var(--size) * 0.56);
    position: relative; height: calc(var(--floor) + var(--size) * 0.32); margin-top: 12px;
  }
  .stage { position: absolute; inset: 0; perspective: 1600px; perspective-origin: 50% 25%; }
  .ring {
    position: absolute; left: 50%; top: var(--centre); width: 0; height: 0; transform-style: preserve-3d;
    transform: translateZ(calc(var(--radius) * -1)) rotateX(-6deg) rotateY(calc(var(--at, 0) * var(--step) * -1));
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .slot {
    position: absolute; left: calc(var(--size) / -2); top: calc(var(--size) / -2); transform-style: preserve-3d;
    transform: rotateY(calc(var(--i) * var(--step))) translateZ(var(--radius));
  }
  .slot .disc { cursor: pointer; transition: transform 0.5s; }
  .slot.front .disc { transform: translateZ(30px); }
  .floor { /* the reflection, fading away below the floor line */
    position: absolute; inset: 0; pointer-events: none;
    -webkit-mask: linear-gradient(180deg, transparent var(--floor), rgb(0 0 0 / 0.32) var(--floor), transparent calc(var(--floor) + var(--size) * 0.3));
    mask: linear-gradient(180deg, transparent var(--floor), rgb(0 0 0 / 0.32) var(--floor), transparent calc(var(--floor) + var(--size) * 0.3));
  }
  .floor .stage { transform-origin: 50% var(--floor); transform: scaleY(-1); }
  .horizon {
    position: absolute; left: 50%; top: var(--floor); width: min(900px, 100%); height: 1px; transform: translateX(-50%); pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.45), transparent);
    box-shadow: 0 0 18px 2px rgb(120 210 255 / 0.25);
  }
  .turn { position: absolute; top: var(--centre); transform: translateY(-50%); z-index: 2; width: 34px; padding: 0; }
  .turn.prev { left: max(0px, calc(50% - var(--size) * 1.3)); }
  .turn.next { right: max(0px, calc(50% - var(--size) * 1.3)); }

  .dots { display: flex; justify-content: center; gap: 6px; margin: 4px 0 18px; }
  .dots button { width: 8px; height: 8px; padding: 0; border-radius: 50%; border: 0; cursor: pointer; background: rgb(255 255 255 / 0.3); }
  .dots button[aria-current="true"] { background: #fff; box-shadow: 0 0 8px 1px var(--glow); }

  .details { display: flex; gap: 20px; align-items: center; max-width: 640px; margin: 0 auto; padding: 18px 22px; }
  .details[hidden] { display: none; }
  .details .text { flex: 1; min-width: 0; }
  .details h2 { font-size: clamp(1.6rem, 5vw, 2.1rem); line-height: 1.15; text-shadow: 0 0 16px rgb(110 200 255 / 0.35); }
  .details .byline { margin: 4px 0 0; color: var(--text-dim); }
  .details .blurb { margin: 10px 0 6px; }
  .details .facts { margin: 0; font-size: 0.85rem; color: var(--text-faint); }
  .details .play { display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--text-dim); font-size: 0.85rem; text-decoration: none; }
  .details .play .orb { width: 68px; height: 68px; }

  .about { max-width: 640px; margin: 20px auto 0; padding: 14px 22px; }
  .about h3 { font-size: 1.05rem; font-weight: 400; }
  .about p { margin: 4px 0 0; color: var(--text-dim); }
  @media (max-width: 520px) {
    .details { flex-direction: column; align-items: stretch; text-align: left; }
    .details .play { flex-direction: row; justify-content: center; }
  }
</style>

<header>
  <h1 class="wordmark"><img class="logo" src={url("favicon.svg")} alt="">menuseum</h1>
  <p>An archive of interactive DVD menus</p>
</header>

<main>
  <section class="shelf" id="shelf" aria-roledescription="carousel" aria-label="Discs">
    <div class="floor" aria-hidden="true"><div class="stage"><div class="ring" id="mirror">
      {discs.map((d, i) => <div class="slot" style={`--i: ${i}`} set:html={discMarkup(d)} />)}
    </div></div></div>
    <div class="horizon"></div>
    <div class="stage"><div class="ring" id="ring">
      {discs.map((d, i) => (
        <div class="slot" style={`--i: ${i}`} data-slug={d.slug} data-href={playUrl(d)} data-label={`${d.title} (${d.system})`} set:html={discMarkup(d)} />
      ))}
    </div></div>
    <button class="btn turn prev" aria-label="Previous disc"><svg viewBox="0 0 10 10"><path d="M7 1 2.5 5 7 9z"/></svg></button>
    <button class="btn turn next" aria-label="Next disc"><svg viewBox="0 0 10 10"><path d="M3 1 7.5 5 3 9z"/></svg></button>
  </section>
  <nav class="dots" id="dots" aria-label="Choose a disc">
    {discs.map((d) => <button aria-label={`${d.title} (${d.system})`} />)}
  </nav>

  <div id="details" aria-live="polite">
    {discs.length === 0 && <section class="details glass">No discs yet.</section>}
    {discs.map((d, i) => (
      <section class="details glass" hidden={i !== 0}>
        <div class="text">
          <h2>{d.title}</h2>
          <p class="byline">{by(d) && `${by(d)} `}<span class="tag">{d.system}</span></p>
          <p class="blurb">{d.blurb}</p>
          <p class="facts">{facts(d)}</p>
        </div>
        <a class="play" href={playUrl(d)}><span class="orb"><svg viewBox="0 0 10 10"><path d="M2.5 1.2 9 5 2.5 8.8z"/></svg></span>Play</a>
      </section>
    ))}
  </div>

  <section class="about glass">
    <h3>About</h3>
    <p>These menus run from the original disc data. The films aren't included.</p>
  </section>

  <section class="about glass">
    <h3>Your own DVD</h3>
    <p>Have a DVD copied to your computer? <a href={url("play/local/")}>Play its VIDEO_TS folder</a>, menus and film. It plays from your own files; nothing is uploaded.</p>
  </section>
</main>
</Base>

<script>
import { light } from "../lib/light.js";

const $ = (id) => document.getElementById(id);
const shelf = $("shelf");
const slots = [...$("ring").children], mirrors = [...$("mirror").children];
const dots = [...$("dots").children], details = [...$("details").children];
light(shelf);

// Ring geometry: discs sit edge to edge, plus a gap, around a circle.
function layout() {
  const size = shelf.querySelector(".disc")?.offsetWidth || 280;
  const n = Math.max(slots.length, 3);
  shelf.style.setProperty("--step", `${360 / n}deg`);
  shelf.style.setProperty("--radius", `${(size / 2 + size * 0.12) / Math.tan(Math.PI / n)}px`);
}

let at = 0, turn = 0, swipedAt = 0;
slots.forEach((slot, i) => {
  const disc = slot.querySelector(".disc");
  disc.setAttribute("role", "button");
  disc.setAttribute("aria-label", slot.dataset.label);
  disc.addEventListener("click", () => {
    if (performance.now() - swipedAt < 300) return; // the end of a swipe, not a click
    i === at ? play() : go(i);
  });
  dots[i].addEventListener("click", () => go(i));
});
layout();
addEventListener("resize", layout);

// `turn` counts whole revolutions too, so the ring always takes the short way round.
function go(i, { replace = false } = {}) {
  const n = slots.length;
  if (!n) return;
  i = ((i % n) + n) % n;
  let delta = i - at;
  if (delta > n / 2) delta -= n;
  if (delta < -n / 2) delta += n;
  turn += delta;
  at = i;
  shelf.style.setProperty("--at", turn);
  for (const list of [slots, mirrors]) {
    list.forEach((s, j) => {
      s.classList.toggle("front", j === i);
      s.querySelector(".disc").classList.toggle("spinning", j === i);
    });
  }
  slots.forEach((s, j) => (s.querySelector(".disc").tabIndex = j === i ? 0 : -1));
  dots.forEach((b, j) => b.setAttribute("aria-current", j === i));
  details.forEach((d, j) => (d.hidden = j !== i));
  history[replace ? "replaceState" : "pushState"](null, "", `#${encodeURIComponent(slots[i].dataset.slug)}`);
}
const play = () => slots.length && (location.href = slots[at].dataset.href);
const fromHash = () => slots.findIndex((s) => s.dataset.slug === decodeURIComponent(location.hash.slice(1)));

if (slots.length) go(Math.max(fromHash(), 0), { replace: true });
addEventListener("popstate", () => {
  const i = fromHash();
  if (i >= 0 && i !== at) go(i, { replace: true });
});

document.querySelector(".turn.prev").addEventListener("click", () => go(at - 1));
document.querySelector(".turn.next").addEventListener("click", () => go(at + 1));
addEventListener("keydown", (e) => {
  if (document.querySelector("dialog[open]") || e.target.closest?.("a, input")) return;
  if (e.key === "ArrowLeft") go(at - 1);
  else if (e.key === "ArrowRight") go(at + 1);
  else if (e.key === "Enter" && !e.target.closest?.("button")) play();
  else return;
  e.preventDefault();
});

// Swipe and sideways scroll turn the ring a disc at a time.
let swipe = null, wheelAt = 0;
shelf.addEventListener("pointerdown", (e) => (swipe = { x: e.clientX }));
addEventListener("pointerup", (e) => {
  if (!swipe) return;
  const dx = e.clientX - swipe.x;
  swipe = null;
  if (Math.abs(dx) > 40) {
    swipedAt = performance.now();
    go(at + (dx < 0 ? 1 : -1));
  }
});
shelf.addEventListener("wheel", (e) => {
  const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : 0;
  if (Math.abs(d) < 8 || performance.now() - wheelAt < 450) return;
  wheelAt = performance.now();
  go(at + Math.sign(d));
  e.preventDefault();
}, { passive: false });
</script>
