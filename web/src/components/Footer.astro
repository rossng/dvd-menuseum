---
// The footer every page ends with: a link to the licences of everything the
// site serves (the notices page, which says where the player's source is,
// for the GPL), and the Seal of Slop.
import { url } from "../lib/site.js";

const SEAL = `This project is 100% vibe coded and I have not reviewed the code.

After seeing https://dvdmoviemenus.com/ I wished that there was an interactive archive available and thought it would be cool if we could do the entire thing client-side from the original DVD data.

No guarantees or support are offered.`;
---
<footer>
  <a href={url("notices/")}>Licences</a>
  <seal-of-slop size="40" text={SEAL}></seal-of-slop>
</footer>

<script>
  // The seal is most of the site's script by size: load it once the page,
  // and the player on it, have settled.
  const seal = () => import("seal-of-slop");
  if ("requestIdleCallback" in window) requestIdleCallback(seal, { timeout: 3000 });
  else setTimeout(seal, 1500);
</script>
